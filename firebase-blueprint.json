{
  "entities": {
    "users": {
      "title": "User Profiles",
      "description": "User profiles authenticated via Firebase Phone Auth",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "phoneNumber": { "type": "string", "description": "User's chip number in international format, e.g., +5511999999999" },
        "displayName": { "type": "string" },
        "avatarColor": { "type": "string", "description": "Hex color for placeholder avatar" },
        "initial": { "type": "string", "description": "First letter of displayName uppercase" },
        "photoURL": { "type": "string", "description": "Optional URL from Firebase Storage" },
        "about": { "type": "string", "description": "Optional status message" },
        "lastSeen": { "type": "number" },
        "isOnline": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["phoneNumber", "displayName", "avatarColor", "initial"]
    },
    "chats": {
      "title": "Chat Conversations",
      "description": "Direct and group conversation channels",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "isGroup": { "type": "boolean" },
        "avatarColor": { "type": "string" },
        "avatarLetter": { "type": "string" },
        "createdBy": { "type": "string" },
        "statusText": { "type": "string" },
        "online": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "lastMessage": { "type": "string" },
        "lastMessageTime": { "type": "string" },
        "lastMessageTimestamp": { "type": "number" },
        "unreadCount": { "type": "number" }
      },
      "required": ["name", "isGroup", "avatarColor", "avatarLetter", "createdBy"]
    },
    "chats/messages": {
      "title": "Chat Messages",
      "description": "Messages inside each conversation channel",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "senderPhoneNumber": { "type": "string", "description": "The chip number of the person who sent the message" },
        "senderName": { "type": "string" },
        "senderId": { "type": "string" },
        "time": { "type": "string" },
        "timestamp": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["text", "senderPhoneNumber", "time", "timestamp"]
    },
    "chats/typing": {
      "title": "Typing Status",
      "description": "Real-time indicator when a participant is typing or recording audio",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "state": { "type": "string", "enum": ["typing", "recording"] },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "state", "updatedAt"]
    },
    "statuses": {
      "title": "User Status Updates",
      "description": "Stories with photos or videos published by contacts",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhone": { "type": "string" },
        "avatarColor": { "type": "string" },
        "photoURL": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["image", "video"] },
        "caption": { "type": "string" },
        "timestamp": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "userName", "mediaUrl", "mediaType", "timestamp"]
    },
    "system_settings": {
      "title": "System Settings and Branding",
      "description": "Global application branding, custom logos, and persistent appearance configuration",
      "type": "object",
      "properties": {
        "logoUrl": { "type": "string", "description": "Persistent Google Cloud Storage URL for the official Tribbu logo" },
        "logoBase64": { "type": "string", "description": "Base64 data representation of the logo for offline and instant display" },
        "updatedAt": { "type": "number", "description": "Timestamp when the logo was last modified" },
        "updatedBy": { "type": "string", "description": "Identifier of the user who updated the branding" }
      },
      "required": ["updatedAt"]
    }
  }
}
